Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
    - Class: moveit_rviz_plugin/PlanningScene
      Name: PlanningScene
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Scene Geometry:
        Scene Alpha: 0.6
        Show Scene Geometry: true
      Scene Robot:
        Show Robot Visual: true
        Show Robot Collision: false
        Robot Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Marker Scale: 0.15
      Frames:
        All Enabled: false
        camera_link: {Value: true}
        camera_optical_frame: {Value: true}
    - Class: rviz_default_plugins/MarkerArray
      Name: Calibration markers
      Enabled: true
      Topic:
        Value: /handeye_autopilot/markers
    - Class: rviz_default_plugins/PointCloud2
      Name: Obstacle cloud
      Enabled: true
      Size (m): 0.01
      Topic:
        Value: /demo/obstacle_points
    - Class: rviz_default_plugins/Image
      Name: Camera (annotated)
      Enabled: true
      Topic:
        Value: /handeye_autopilot/annotated_image
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point: {X: 0.4, Y: 0, Z: 0.3}
      Pitch: 0.45
      Yaw: 0.6
Window Geometry:
  Width: 1400
  Height: 900
